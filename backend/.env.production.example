POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=lumefy
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=lumefy
DATABASE_URL=postgresql+asyncpg://lumefy:replace-with-a-long-random-password@db:5432/lumefy
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
# Keep this key in an external secret manager; it is required to decrypt gateway credentials after restore.
ENVIRONMENT=production
SQL_ECHO=false
FRONTEND_URL=https://admin.example.com
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password
BACKEND_CORS_ORIGINS=["https://admin.example.com","https://example.com"]
PLATFORM_STOREFRONT_DOMAIN=lumefy.shop
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-smtp-user
MAIL_PASSWORD=replace-with-a-long-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Lumefy
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true
