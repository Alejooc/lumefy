POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=lumefy
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=lumefy
DATABASE_URL=postgresql+asyncpg://lumefy:replace-with-a-long-random-password@db:5432/lumefy
REDIS_URL=redis://redis:6379/0
INTEGRATION_ALLOW_PRIVATE_NETWORKS=false
INTEGRATION_REQUEST_TIMEOUT_SECONDS=30
INTEGRATION_RETRY_ATTEMPTS=2
INTEGRATION_RETRY_BASE_SECONDS=0.5
INTEGRATION_RETRY_MAX_SECONDS=8
INTEGRATION_MAX_RESPONSE_BYTES=20971520
NPM_PROVISIONING_ENABLED=false
# Usa el nombre real del contenedor de NPM dentro de PROXY_NETWORK.
NPM_API_URL=http://nginx-proxy-manager:81/api
NPM_IDENTITY=replace-with-dedicated-npm-user
NPM_PASSWORD=replace-with-a-long-random-password
NPM_FORWARD_SCHEME=http
NPM_STOREFRONT_HOST=lumefy-storefront-1
NPM_STOREFRONT_PORT=3000
NPM_VERIFY_SSL=true
NPM_REQUEST_TIMEOUT_SECONDS=30
NPM_CERTIFICATE_TIMEOUT_SECONDS=900
NPM_PROVISIONING_MAX_ATTEMPTS=3
NPM_PROVISIONING_CONCURRENCY=1
NPM_PROVISIONING_POLL_SECONDS=2
NPM_PROVISIONING_STALE_MINUTES=30
SECRET_KEY=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
# Keep this key in an external secret manager; it is required to decrypt gateway credentials after restore.
ENVIRONMENT=production
SQL_ECHO=false
FRONTEND_URL=https://app.jaofy.com
FIRST_SUPERUSER=admin@jaofy.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password
BACKEND_CORS_ORIGINS=["https://app.jaofy.com","https://jaofy.com"]
PLATFORM_STOREFRONT_DOMAIN=jaofy.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-smtp-user
MAIL_PASSWORD=replace-with-a-long-smtp-password
MAIL_FROM=no-reply@jaofy.com
MAIL_FROM_NAME=Jaofy
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true
