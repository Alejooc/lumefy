# Configuración de Base de Datos
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lumefy_db
POSTGRES_PORT=5432

# URL de Base de Datos (Para SQLAlchemy)
# Formato: postgresql+asyncpg://usuario:password@servidor:puerto/nombre_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lumefy_db
INTEGRATION_ALLOW_PRIVATE_NETWORKS=false
INTEGRATION_REQUEST_TIMEOUT_SECONDS=30
INTEGRATION_RETRY_ATTEMPTS=2
INTEGRATION_RETRY_BASE_SECONDS=0.5
INTEGRATION_RETRY_MAX_SECONDS=8
INTEGRATION_MAX_RESPONSE_BYTES=20971520

# Aprovisionamiento automático de dominios en Nginx Proxy Manager.
# La URL debe ser interna y accesible desde la red Docker compartida.
NPM_PROVISIONING_ENABLED=false
NPM_API_URL=http://nginx-proxy-manager:81/api
NPM_IDENTITY=
NPM_PASSWORD=
NPM_FORWARD_SCHEME=http
NPM_STOREFRONT_HOST=lumefy-storefront-1
NPM_STOREFRONT_PORT=3000
NPM_VERIFY_SSL=true
NPM_REQUEST_TIMEOUT_SECONDS=30
NPM_CERTIFICATE_TIMEOUT_SECONDS=900
NPM_PROVISIONING_MAX_ATTEMPTS=3
NPM_PROVISIONING_CONCURRENCY=1
NPM_PROVISIONING_POLL_SECONDS=2
NPM_PROVISIONING_STALE_MINUTES=30

# Seguridad
SECRET_KEY=tu_clave_secreta_super_segura_cambiala_en_produccion
# Opcional en desarrollo. Obligatoria y separada de SECRET_KEY en producción.
CREDENTIAL_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Superusuario Inicial (Se crea al iniciar el sistema si no existe)
FIRST_SUPERUSER=admin@jaofy.com
FIRST_SUPERUSER_PASSWORD=admin123

# Configuración del Proyecto
PROJECT_NAME=Jaofy
API_V1_STR=/api/v1
