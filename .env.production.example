POSTGRES_USER=lumefy
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=lumefy
ADMIN_DOMAIN=app.jaofy.com
PLATFORM_STOREFRONT_DOMAIN=jaofy.com
ACME_EMAIL=ops@jaofy.com
# Name of the external Docker network used by Nginx Proxy Manager.
# Confirm it with: docker network ls
PROXY_NETWORK=npm_default
BACKUP_RETENTION_DAYS=14
# Optional: local path for complete database + uploads backups.
BACKUP_DIR=./backups/production
# Keep production defaults unless running an isolated validation stack.
POSTGRES_VOLUME_NAME=lumefy_postgres_data
REDIS_VOLUME_NAME=lumefy_redis_data
BACKEND_STATIC_VOLUME=lumefy_backend_static
CADDY_DATA_VOLUME_NAME=lumefy_caddy_data
CADDY_CONFIG_VOLUME_NAME=lumefy_caddy_config
